<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Torii.Views.NameDialog"
        Title="New instance"
        Icon="/Assets/torii.ico"
        SizeToContent="WidthAndHeight"
        MinWidth="360"
        MaxWidth="480"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="12">
        <TextBox x:Name="NameBox" PlaceholderText="Name" MaxLength="50" MinWidth="320" />
        <TextBlock x:Name="ProblemText" Foreground="Orange" TextWrapping="Wrap" MaxWidth="440" IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center" />
            <Button x:Name="ConfirmButton"
                    Content="Create"
                    MinWidth="80"
                    HorizontalContentAlignment="Center"
                    IsDefault="True"
                    IsEnabled="False"
                    Classes="accent" />
        </StackPanel>
    </StackPanel>
</Window>
