<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Optris.Icons.Avalonia"
        x:Class="Torii.Views.MessageDialog"
        Title="Torii"
        Icon="/Assets/torii.ico"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        MaxWidth="480"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="16">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <icons:Icon Value="mdi-alert-circle" FontSize="28" Foreground="Orange" VerticalAlignment="Top" />
            <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center" />
        </Grid>
        <Button x:Name="OkButton"
                Content="OK"
                MinWidth="80"
                HorizontalAlignment="Right"
                HorizontalContentAlignment="Center"
                IsDefault="True"
                Classes="accent" />
    </StackPanel>
</Window>
