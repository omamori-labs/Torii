<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Torii.ViewModels"
        xmlns:views="using:Torii.Views"
        xmlns:icons="using:Optris.Icons.Avalonia"
        x:Class="Torii.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Torii"
        Icon="/Assets/torii.ico"
        Width="820" Height="520"
        MinWidth="680" MinHeight="360">
    <Grid ColumnDefinitions="220,*">
        <DockPanel Margin="12">
            <Button DockPanel.Dock="Top"
                    Content="New instance"
                    Command="{Binding NewInstanceCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,0,8" />

            <views:UpdateView DockPanel.Dock="Bottom" DataContext="{Binding Update}" />

            <ListBox x:Name="InstanceList" ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" CornerRadius="4">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:InstanceViewModel">
                        <Border Padding="12,13,12,15" Background="Transparent">
                            <Border.ContextFlyout>
                                <MenuFlyout OverlayDismissEventPassThrough="True">
                                    <MenuItem Header="Open folder" Command="{Binding OpenFolderCommand}">
                                        <MenuItem.Icon>
                                            <icons:Icon Value="mdi-folder-open" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rename" Command="{Binding RenameCommand}">
                                        <MenuItem.Icon>
                                            <icons:Icon Value="mdi-pencil" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}">
                                        <MenuItem.Icon>
                                            <icons:Icon Value="mdi-content-copy" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete" Command="{Binding DeleteCommand}">
                                        <MenuItem.Icon>
                                            <icons:Icon Value="mdi-delete" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding ModsLabel}" Opacity="0.6" />
                                    <TextBlock Text="Running" IsVisible="{Binding OsuRunning}" Foreground="Orange" />
                                    <TextBlock Text="Update"
                                               IsVisible="{Binding HasOmamoriUpdate}"
                                               ToolTip.Tip="{Binding OmamoriUpdateTip}"
                                               Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="0,12,16,12">
            <TextBlock DockPanel.Dock="Top"
                       Text="{Binding Selected.Summary}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <TextBlock Text="Create an instance to get started." IsVisible="{Binding !HasInstances}" Opacity="0.6" />

            <Panel IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <views:InstanceView DataContext="{Binding Selected}" />
            </Panel>
        </DockPanel>
    </Grid>
</Window>
